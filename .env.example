# CodeAI API — environment configuration
# Copy this file to .env and fill in your real values:  cp .env.example .env

# PRIMARY provider: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# PLAN C (optional): a SECOND Groq API key, kept in reserve. Used only
# after Plan A (GROQ_API_KEY) AND Plan B (NVIDIA) have both failed —
# e.g. when the primary Groq key reaches its usage limit. Leave unset
# to run with just Plan A -> Plan B.
# GROQ_API_KEY_2=<redacted>

# BACKUP provider (Plan B): NVIDIA NIM API key (https://build.nvidia.com)
# Used automatically when Groq is missing, fails, rate-limits, or times out.
NVIDIA_API_KEY=

# NVIDIA model. NVIDIA rotates/retires models: this default was
# verified working live on 2026-10-20. The three models from NEUTRON's
# catalog (llama-3.3-nemotron-super-49b-v1, llama-3.1-70b-instruct,
# llama-3.3-70b-instruct) currently FAIL live (410/410/404) and are
# kept only as last-resort fallbacks — if the chosen model 404s or
# 410s, the server tries the next one automatically.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Server port
PORT=3000

# Groq model. NOTE: llama-3.3-70b-versatile was moved to
# enterprise-only pricing by Groq in Aug 2026 — free/self-serve keys get
# 404 model_not_found for it. openai/gpt-oss-120b is the current
# self-serve production model (verified live 2026-10-20).
MODEL=openai/gpt-oss-120b

# Optional: comma-separated Groq model fallback list. If the chosen
# model answers model_not_found, the next one is tried automatically.
# Replaces the built-in list (gpt-oss-120b, gpt-oss-20b,
# llama-4-scout-17b-16e-instruct, qwen3-32b) when set.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Max tokens per AI response
MAX_TOKENS=8192

# Rate limits (per minute, per IP / API key).
# Defaults are intentionally high: a whole classroom of students usually
# shares ONE public IP behind the college Wi-Fi NAT, so low per-IP limits
# would block everyone. Upstream overload is controlled by
# MAX_CONCURRENT_AI + caching + request coalescing instead.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
GENERATE_RATE_LIMIT=500

# How many AI (Groq) requests may run at the same time. Extra requests
# queue for up to QUEUE_TIMEOUT_MS, then get a friendly HTTP 503.
MAX_CONCURRENT_AI=10
QUEUE_TIMEOUT_MS=30000

# In-memory cache TTL (seconds)
CACHE_TTL=3600

# Optional: if set, clients must send this as X-Api-Key header
# (leave empty for open access, e.g. classroom use)
API_SECRET_KEY=

# CORS origin (use * for open access)
CORS_ORIGIN=*

# Logging: debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=production

# TEST ONLY — never enable in production. Returns clearly-labeled fake
# code instead of calling Groq, for local concurrency/load testing.
# CODEAI_TEST_STUB=0
# CODEAI_TEST_STUB_DELAY_MS=300
